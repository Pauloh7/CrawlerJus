# Copie este arquivo para `.env` e ajuste os valores conforme necessário.
# Usado apenas para desenvolvimento local sem Docker (o docker-compose.yml
# já define essas variáveis para os containers).

# Redis (cache das consultas processuais)
CACHE_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# PostgreSQL (checkpoint do LangGraph)
LANGGRAPH_DB_URL=postgresql://postgres:postgres@localhost:5432/crawlerjus

# Ollama (runtime do modelo Qwen usado pelo agente de IA)
OLLAMA_BASE_URL=http://localhost:11434
